# ==============================================================================
# Acacia Platform - Environment Configuration Template
# Copy this file to .env and populate with your credentials
# ==============================================================================

# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000;https://+:5001

# --- MonsterASP / SQL Server Database ---
ConnectionStrings__AcaciaDbContext="Server=localhost;Database=db_Acacia;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False;TrustServerCertificate=True;"

# --- JWT Authentication Settings ---
JwtSettings__SecretKey="change-this-to-a-secure-random-256-bit-key-in-production!"
JwtSettings__Issuer="Acacia.Api"
JwtSettings__Audience="AcaciaUser"
JwtSettings__DurationInMinutes=60

# --- Backblaze B2 S3-Compatible Cloud Storage ---
Backblaze__BucketName="acacia-storage"
Backblaze__Region="us-east-005"
Backblaze__Endpoint="https://s3.us-east-005.backblazeb2.com"
Backblaze__AccessKey="your-backblaze-application-key-id"
Backblaze__SecretKey="your-backblaze-application-key"

# --- CORS & Client Origin ---
Cors__AllowedOrigins="http://localhost:4200,https://acacia.monsterasp.net"
