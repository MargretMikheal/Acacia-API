{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AcaciaDbContext": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECURE_PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "Acacia.Api",
    "Audience": "AcaciaUser",
    "DurationInMinutes": 60
  },
  "Backblaze": {
    "BucketName": "acacia-storage",
    "Region": "us-east-005",
    "Endpoint": "https://s3.us-east-005.backblazeb2.com",
    "AccessKey": "YOUR_BACKBLAZE_APPLICATION_KEY_ID",
    "SecretKey": "YOUR_BACKBLAZE_APPLICATION_KEY"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://acacia.tryasp.net",
      "https://acacia.runasp.net",
      "http://localhost:4200"
    ]
  }
}
