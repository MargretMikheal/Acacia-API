{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AcaciaDbContext": "Server=localhost;Database=db_Acacia;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "temporary-development-key-replace-in-production-min-32-chars",
    "Issuer": "Acacia.Api",
    "Audience": "AcaciaUser",
    "DurationInMinutes": 60
  },
  "Backblaze": {
    "BucketName": "acacia-storage",
    "Region": "us-east-005",
    "Endpoint": "https://s3.us-east-005.backblazeb2.com",
    "AccessKey": "YOUR_BACKBLAZE_APPLICATION_KEY_ID",
    "SecretKey": "YOUR_BACKBLAZE_APPLICATION_KEY"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
